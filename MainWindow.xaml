<Window x:Class="FlashStickNote.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FlashStickNote.Controls"
        Title="FlashStickNote"
        Width="920" Height="620"
        MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Theme.WindowBackground}">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Background" Value="{DynamicResource Theme.ListHeaderBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.ListHeaderForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderColor}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22000000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" MinWidth="140"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*" MinWidth="300"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="3"
                Background="{DynamicResource Theme.ListHeaderBackground}">
            <Menu HorizontalAlignment="Left"
                  Background="Transparent"
                  Foreground="{DynamicResource Theme.ListHeaderForeground}">
                <MenuItem Header="文件">
                    <MenuItem Header="新建笔记" Click="NewNoteMenuItem_Click"/>
                    <MenuItem Header="隐藏到托盘" Click="HideToTrayMenuItem_Click"/>
                    <Separator/>
                    <MenuItem Header="退出" Click="ExitMenuItem_Click"/>
                </MenuItem>
            </Menu>
        </Border>

        <!-- 左侧笔记列表 -->
        <DockPanel Grid.Row="1" Grid.Column="0" Background="{DynamicResource Theme.ListBackground}">
            <Border DockPanel.Dock="Top" Padding="8" Background="{DynamicResource Theme.ListHeaderBackground}"
                    BorderBrush="{DynamicResource Theme.BorderColor}" BorderThickness="0,0,0,1">
                <StackPanel>
                    <Grid>
                        <TextBox x:Name="SearchBox"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="6,3"
                                 VerticalContentAlignment="Center"
                                 Background="{DynamicResource Theme.EditorBackground}"
                                 Foreground="{DynamicResource Theme.EditorForeground}"
                                 CaretBrush="{DynamicResource Theme.EditorForeground}"
                                 BorderBrush="{DynamicResource Theme.BorderColor}"/>
                        <TextBlock Text="搜索标题或内容"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Foreground="{DynamicResource Theme.ListTertiaryForeground}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <CheckBox Content="正则" IsChecked="{Binding UseRegex}" ToolTip="按 .NET 正则表达式匹配"/>
                        <CheckBox Content="全字" IsChecked="{Binding MatchWholeWord}" Margin="12,0,0,0" ToolTip="只匹配完整单词"/>
                        <CheckBox Content="区分大小写" IsChecked="{Binding MatchCase}" Margin="12,0,0,0" ToolTip="按输入的大小写匹配"/>
                    </StackPanel>
                    <TextBlock Text="{Binding SearchError}"
                               Foreground="IndianRed"
                               Margin="0,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <ListBox x:Name="NoteList"
                     ItemsSource="{Binding Notes}"
                     SelectedItem="{Binding SelectedNote, Mode=OneWay}"
                     SelectionChanged="NoteList_SelectionChanged"
                     PreviewMouseRightButtonDown="NoteList_PreviewMouseRightButtonDown"
                     KeyDown="NoteList_KeyDown"
                     BorderThickness="0"
                     Background="{DynamicResource Theme.ListBackground}"
                     Foreground="{DynamicResource Theme.ListForeground}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="删除" Click="DeleteContextMenuItem_Click"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Foreground" Value="{DynamicResource Theme.ListForeground}"/>
                        <Setter Property="Padding" Value="6,2"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Theme.ListSelectedBackground}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Theme.ListSelectedForeground}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,6">
                            <TextBlock Text="{Binding DisplayTitle}"
                                       FontFamily="{DynamicResource Theme.ListTitleFontFamily}"
                                       FontSize="{DynamicResource Theme.ListTitleFontSize}"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding ContentPreview}"
                                       FontFamily="{DynamicResource Theme.ListPreviewFontFamily}"
                                       FontSize="{DynamicResource Theme.ListPreviewFontSize}"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource Theme.ListSecondaryForeground}"
                                       Margin="0,2,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding UpdatedAt, StringFormat='{}{0:MM-dd HH:mm}'}"
                                       FontSize="11"
                                       Foreground="{DynamicResource Theme.ListTertiaryForeground}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- 左右分隔条 -->
        <GridSplitter Grid.Row="1" Grid.Column="1"
                      Width="5"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="{DynamicResource Theme.SplitterColor}"
                      ResizeBehavior="PreviousAndNext"
                      ResizeDirection="Columns"/>

        <!-- 右侧编辑区 -->
        <Grid Grid.Row="1" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBox x:Name="TitleBox"
                     Grid.Row="0"
                     Text="{Binding SelectedNote.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Padding="10,8"
                     BorderThickness="0"
                     Background="{DynamicResource Theme.EditorBackground}"
                     Foreground="{DynamicResource Theme.EditorForeground}"
                     CaretBrush="{DynamicResource Theme.EditorForeground}"
                     FontWeight="Bold"/>

            <Border Grid.Row="1" BorderBrush="{DynamicResource Theme.BorderColor}" BorderThickness="0,1,0,0">
                <controls:NoteTextEditor x:Name="ContentBox"
                                       Padding="8"
                                       BorderThickness="0"
                                       Background="{DynamicResource Theme.EditorBackground}"
                                       Foreground="{DynamicResource Theme.EditorForeground}"
                                       VerticalScrollBarVisibility="Auto"/>
            </Border>

            <Border x:Name="DocumentStatisticsPanel"
                    Grid.Row="2"
                    Padding="8,3"
                    Background="{DynamicResource Theme.ListHeaderBackground}"
                    BorderBrush="{DynamicResource Theme.BorderColor}"
                    BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="行数：" Foreground="{DynamicResource Theme.ListTertiaryForeground}"/>
                    <TextBlock Text="{Binding SelectedNote.LineCount, TargetNullValue=0}"
                               Foreground="{DynamicResource Theme.ListHeaderForeground}"/>
                    <TextBlock Text="    字数：" Foreground="{DynamicResource Theme.ListTertiaryForeground}"/>
                    <TextBlock Text="{Binding SelectedNote.CharacterCount, TargetNullValue=0}"
                               Foreground="{DynamicResource Theme.ListHeaderForeground}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
